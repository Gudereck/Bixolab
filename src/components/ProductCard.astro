---
import { Image } from 'astro:assets';
import ProductMockup from './ProductMockup.astro';
import { colecaoPorSlug, nomeModelo } from '../data/loja';
import { formatarPreco, type Produto } from '../lib/produtos';

interface Props {
  produto: Produto;
  indice?: number;
}

const { produto, indice = 0 } = Astro.props;
const { nome, curso, modelo, cores, estampa, subestampa, fotos, preco, novidade, disponivel } = produto.data;
const capa = fotos[0];
---

<article class="card" data-reveal style={`--i: ${indice % 4}`}>
  <a href={`/produto/${produto.id}`} class="card__link">
    <div class="card__media">
      {capa ? (
        <Image src={capa} alt="" widths={[320, 480, 640]} sizes="(min-width: 1100px) 25vw, (min-width: 768px) 33vw, 50vw" />
      ) : (
        <ProductMockup modelo={modelo} cor={cores[0].hex} estampa={estampa} subestampa={subestampa} class="card__mockup" />
      )}
      {!disponivel ? <span class="selo selo--off">Esgotado</span> : novidade && <span class="selo">Novidade</span>}
    </div>
    <div class="card__info">
      <h3 class="card__nome">{nome}</h3>
      <p class="card__meta">
        <span>{nomeModelo[modelo]} · {colecaoPorSlug(curso)?.nome}</span>
        {preco && <span class="card__preco">{formatarPreco(preco)}</span>}
      </p>
      <ul class="card__cores" aria-label={`${cores.length} ${cores.length > 1 ? 'cores' : 'cor'}: ${cores.map((c) => c.nome).join(', ')}`}>
        {cores.map((c) => <li style={`--c: ${c.hex}`}></li>)}
      </ul>
    </div>
  </a>
</article>

<style>
  .card__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .card__media {
    position: relative;
    aspect-ratio: 4 / 5;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: var(--surface);
    border-radius: var(--radius-lg);
  }
  .card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .card__media :global(.card__mockup) {
    width: 82%;
    transition: transform 400ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .card__link:hover :global(.card__mockup) {
      transform: translateY(-6px) rotate(-2deg);
    }
    .card__link:hover .card__nome {
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 0.2em;
    }
  }
  .card__link:focus-visible {
    outline: none;
  }
  .card__link:focus-visible .card__media {
    outline: 3px solid var(--ring);
    outline-offset: 3px;
  }
  .selo {
    position: absolute;
    top: var(--s-3);
    left: var(--s-3);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--gold);
    color: var(--ink);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .selo--off {
    background: var(--ink);
    color: var(--paper);
  }
  .card__info {
    padding-top: var(--s-3);
  }
  .card__nome {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .card__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-2);
    margin-top: 0.15rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }
  .card__preco {
    color: var(--text);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .card__cores {
    display: flex;
    gap: 0.35rem;
    margin: var(--s-2) 0 0;
    padding: 0;
    list-style: none;
  }
  .card__cores li {
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 50%;
    background: var(--c);
    box-shadow: inset 0 0 0 1px rgb(20 22 19 / 0.25);
  }
</style>
