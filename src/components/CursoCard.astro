---
import ProductMockup from './ProductMockup.astro';
import Icon from './Icon.astro';
import type { Curso } from '../data/loja';
import { corEstampa } from '../lib/cor';

interface Props {
  curso: Curso;
  total: number;
  indice?: number;
}
const { curso, total, indice = 0 } = Astro.props;
const tinta = corEstampa(curso.cor);
---

<a
  href={`/catalogo/${curso.slug}`}
  class="curso"
  data-reveal
  style={`--i: ${indice % 4}; --bg: ${curso.cor}; --fg: ${tinta}`}
>
  <h3 class="curso__nome">{curso.nome}</h3>
  <p class="curso__total">{total} {total === 1 ? 'peça' : 'peças'}</p>
  <div class="curso__art">
    <ProductMockup modelo="camiseta" cor="#f5f2ea" estampa={curso.estampa} subestampa="TURMA 2026" />
  </div>
  <span class="curso__seta"><Icon name="arrow-up-right" /></span>
</a>

<style>
  .curso {
    position: relative;
    display: block;
    min-height: 11.5rem;
    padding: var(--s-4);
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--bg);
    color: var(--fg);
    text-decoration: none;
    isolation: isolate;
    transition: transform 160ms var(--ease-out);
  }
  .curso:active {
    transform: scale(0.98);
  }
  .curso__nome {
    position: relative;
    z-index: 1;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 5.4vw, 2.6rem);
    line-height: 0.95;
    text-transform: uppercase;
  }
  .curso__total {
    position: relative;
    z-index: 1;
    margin-top: var(--s-2);
    font-size: 0.875rem;
    font-weight: 500;
    opacity: 0.85;
  }
  .curso__art {
    position: absolute;
    right: -14%;
    bottom: -20%;
    z-index: -1;
    width: min(78%, 9rem);
    transform: rotate(-8deg);
    transition: transform 400ms var(--ease-out);
  }
  .curso__seta {
    position: absolute;
    left: var(--s-4);
    bottom: var(--s-4);
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--fg);
    color: var(--bg);
    transition: transform 250ms var(--ease-out);
  }
  .curso__seta :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
  }
  .curso:focus-visible {
    outline-offset: 4px;
  }
  @media (min-width: 768px) {
    .curso {
      min-height: 15rem;
      padding: var(--s-5);
    }
    .curso__nome {
      font-size: clamp(1.75rem, 2.9vw, 2.6rem);
    }
    /* A camiseta fica abaixo da linha do nome para não cobrir o texto. */
    .curso__art {
      right: -8%;
      bottom: -40%;
      width: min(60%, 15rem);
    }
    .curso__seta {
      left: var(--s-5);
      bottom: var(--s-5);
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .curso:hover .curso__art {
      transform: rotate(-3deg) translateY(-8px);
    }
    .curso:hover .curso__seta {
      transform: rotate(45deg);
    }
  }
</style>
