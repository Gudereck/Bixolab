---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { loja } from '../data/loja';
import { linkWhatsApp } from '../lib/whatsapp';

const caminho = Astro.url.pathname;
const links = [
  { href: '/catalogo', rotulo: 'Catálogo' },
  { href: '/#turmas', rotulo: 'Turmas & Atléticas' },
  { href: '/#loja', rotulo: 'A loja' },
  { href: '/#duvidas', rotulo: 'Dúvidas' },
];
---

<div class="aviso">
  <div class="container aviso__inner">
    <span>Pedidos pelo WhatsApp</span>
    <span aria-hidden="true">•</span>
    <span>Loja física em {loja.endereco.cidade}</span>
  </div>
</div>

<header class="header" data-header>
  <div class="container header__inner">
    <a href="/" class="header__logo" aria-label="Bixo Lab, página inicial"><Logo /></a>

    <nav class="header__nav" id="menu" aria-label="Principal" data-menu>
      <ul>
        {links.map((l) => (
          <li>
            <a href={l.href} aria-current={caminho.startsWith(l.href) && l.href !== '/' ? 'page' : undefined}>
              {l.rotulo}
            </a>
          </li>
        ))}
      </ul>
      <a href={linkWhatsApp()} class="btn btn--brand header__cta" target="_blank" rel="noopener noreferrer">
        <Icon name="whatsapp" /> Pedir no WhatsApp
      </a>
    </nav>

    <button class="header__toggle" type="button" aria-controls="menu" aria-expanded="false" data-menu-toggle>
      <Icon name="menu" class="icon-open" />
      <Icon name="x" class="icon-close" />
      <span class="visually-hidden">Menu</span>
    </button>
  </div>
</header>

<style>
  .aviso {
    background: var(--ink);
    color: var(--paper);
    font-size: 0.8125rem;
    font-weight: 500;
  }
  .aviso__inner {
    display: flex;
    justify-content: center;
    gap: var(--s-3);
    padding-block: var(--s-2);
  }

  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
    min-height: var(--header-h);
  }
  .header__logo {
    text-decoration: none;
    flex: none;
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: var(--s-6);
  }
  .header__nav ul {
    display: flex;
    gap: var(--s-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .header__nav ul a {
    display: inline-block;
    padding-block: var(--s-2);
    font-weight: 500;
    font-size: 0.9375rem;
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) no-repeat 0 100% / 0 2px;
    transition: background-size 250ms var(--ease-out);
  }
  .header__nav ul a[aria-current='page'] {
    background-size: 100% 2px;
  }
  @media (hover: hover) and (pointer: fine) {
    .header__nav ul a:hover {
      background-size: 100% 2px;
    }
  }
  .header__cta {
    min-height: 2.75rem;
    font-size: 0.875rem;
  }

  .header__toggle {
    display: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 2px solid var(--ink);
    border-radius: 999px;
    background: none;
    cursor: pointer;
  }
  .header__toggle :global(svg) {
    grid-area: 1 / 1;
    width: 1.25rem;
    height: 1.25rem;
  }
  .header__toggle :global(.icon-close) {
    display: none;
  }
  .header__toggle[aria-expanded='true'] :global(.icon-open) {
    display: none;
  }
  .header__toggle[aria-expanded='true'] :global(.icon-close) {
    display: block;
  }

  @media (max-width: 899px) {
    .aviso__inner span:not(:first-child) {
      display: none;
    }
    .header__toggle {
      display: grid;
    }
    .header__nav {
      position: fixed;
      inset: var(--header-h) 0 auto 0;
      z-index: var(--z-menu);
      flex-direction: column;
      align-items: stretch;
      gap: var(--s-5);
      padding: var(--s-5) var(--gutter) var(--s-6);
      background: var(--bg);
      border-bottom: 1px solid var(--line);
      visibility: hidden;
      opacity: 0;
      transform: translateY(-8px);
      transition:
        opacity 200ms var(--ease-out),
        transform 200ms var(--ease-out),
        visibility 0s linear 200ms;
    }
    .header__nav.is-open {
      visibility: visible;
      opacity: 1;
      transform: none;
      transition:
        opacity 200ms var(--ease-out),
        transform 200ms var(--ease-out);
    }
    .header__nav ul {
      flex-direction: column;
      gap: 0;
    }
    .header__nav ul a {
      display: block;
      padding-block: var(--s-3);
      font-family: var(--font-display);
      font-size: 2rem;
      text-transform: uppercase;
      line-height: 1.1;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const header = document.querySelector<HTMLElement>('[data-header]');

  if (toggle && menu && header) {
    const definir = (aberto: boolean) => {
      toggle.setAttribute('aria-expanded', String(aberto));
      menu.classList.toggle('is-open', aberto);
    };
    // O menu móvel fica fixo logo abaixo do cabeçalho.
    const posicionar = () => menu.style.setProperty('top', `${header.getBoundingClientRect().bottom}px`);

    toggle.addEventListener('click', () => {
      posicionar();
      definir(toggle.getAttribute('aria-expanded') !== 'true');
    });
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) definir(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        definir(false);
        toggle.focus();
      }
    });
    matchMedia('(min-width: 900px)').addEventListener('change', () => definir(false));
  }
</script>
