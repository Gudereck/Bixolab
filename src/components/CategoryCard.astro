---
import ProductMockup from './ProductMockup.astro';
import Icon from './Icon.astro';
import type { Categoria } from '../data/loja';

interface Props {
  categoria: Categoria;
  total: number;
  indice?: number;
}
const { categoria, total, indice = 0 } = Astro.props;
---

<a href={`/catalogo/${categoria.slug}`} class="cat" data-reveal style={`--i: ${indice}`}>
  <div class="cat__art">
    <ProductMockup modelo={categoria.modelo} cor={categoria.cor} estampa={categoria.modelo === 'bone' ? 'dino' : 'BIXO'} />
  </div>
  <div class="cat__txt">
    <h3 class="cat__nome">{categoria.nome}</h3>
    <p class="cat__total">{total} {total === 1 ? 'peça' : 'peças'}</p>
  </div>
  <span class="cat__seta"><Icon name="arrow-up-right" /></span>
</a>

<style>
  .cat {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 100%;
    padding: var(--s-4);
    border: 2px solid var(--ink);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: var(--ink);
    background: var(--bg);
    transition:
      background-color 200ms ease,
      transform 160ms var(--ease-out);
  }
  .cat:active {
    transform: scale(0.98);
  }
  .cat__art {
    width: 70%;
    margin: var(--s-2) auto var(--s-4);
    transition: transform 400ms var(--ease-out);
  }
  .cat__nome {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    line-height: 1;
    text-transform: uppercase;
  }
  .cat__total {
    margin-top: var(--s-1);
    font-size: 0.875rem;
    color: var(--text-muted);
  }
  .cat__seta {
    position: absolute;
    top: var(--s-4);
    right: var(--s-4);
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    transition: transform 250ms var(--ease-out);
  }
  .cat__seta :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }
  @media (hover: hover) and (pointer: fine) {
    .cat:hover {
      background: var(--gold);
    }
    .cat:hover .cat__art {
      transform: translateY(-4px) rotate(-3deg);
    }
    .cat:hover .cat__seta {
      transform: rotate(45deg);
    }
  }
</style>
