---
import { DINO_PATH } from './DinoPath';
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={['logo', className]}>
  <svg class="logo__dino" viewBox="0 0 500 414.46" aria-hidden="true"><path d={DINO_PATH} fill="currentColor"></path></svg>
  <span class="logo__txt">Bixo<span>Lab</span></span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 1.6rem;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }
  .logo__dino {
    width: 2.1rem;
    height: auto;
    color: var(--green);
  }
  .logo__txt span {
    color: var(--green);
    margin-left: 0.08em;
  }
</style>
