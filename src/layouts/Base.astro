---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { loja } from '../data/loja';

interface Props {
  titulo?: string;
  descricao?: string;
  /** Caminho de uma imagem em /public (ou URL absoluta) para a prévia do link. */
  imagem?: string;
}

const { titulo, descricao = loja.descricao, imagem = '/og.jpg' } = Astro.props;
const tituloCompleto = titulo ? `${titulo} | ${loja.nome}` : `${loja.nome} | ${loja.slogan}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imagemUrl = new URL(imagem, Astro.site);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f2ea" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={loja.nome} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imagemUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />

    <script>
      // Revela elementos marcados com data-reveal quando entram na tela.
      const alvos = document.querySelectorAll('[data-reveal]');
      if (alvos.length && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -60px 0px' },
        );
        alvos.forEach((el) => io.observe(el));
      } else {
        alvos.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
